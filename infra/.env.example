# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me
# 32 random bytes, Base64. Generate with: openssl rand -base64 32
# Losing this key makes stored CVs unreadable, so back it up.
APP_ENCRYPTION_KEY=
# ollama (needs the "ai" compose profile) or mock (no model; grammar review returns nothing)
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
WEB_PORT=8088
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# Job sources. Arbeitnow works without any setup.
# Company boards on Greenhouse, comma separated (for example: gitlab,stripe)
APP_JOBS_GREENHOUSE_BOARDS=
# Tunisian sources. Keejob uses its public RSS feed. Tanitjobs has no feed and its terms allow personal, non-commercial use only.
APP_JOBS_KEEJOB_ENABLED=true
APP_JOBS_TANITJOBS_ENABLED=false
# France Travail: free credentials from https://francetravail.io (API "Offres d emploi v2")
APP_JOBS_FRANCETRAVAIL_CLIENT_ID=
APP_JOBS_FRANCETRAVAIL_CLIENT_SECRET=
